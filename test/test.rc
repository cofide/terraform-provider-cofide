# This file can be sourced to provide environment variables for testing against
# a local development deployment of Connect. COFIDE_API_TOKEN is intentionally
# not set here: the provider already falls back to reading the token from
# ~/.cofide/credentials (see internal/credentials.LoadFromFile) when it's
# unset, which is what `cofidectl connect login` populates.
export COFIDE_CONNECT_URL="cofide.security:8443"
export COFIDE_INSECURE_SKIP_VERIFY="true"
